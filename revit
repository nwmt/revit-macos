#!/usr/bin/env bash
# Everyday commands for Revit on this Mac: ./revit <command> <year> [bottle]. Run ./revit for the list.
# A thin front for install.sh and scripts/: it checks the arguments, refuses to touch the wrong or a busy bottle, and
# asks before deleting anything. REVIT_CX (tests only) points at a fake CrossOver.
set -uo pipefail
ROOT="$(cd "$(dirname "$0")" && pwd)"; . "$ROOT/scripts/lib/common.sh"
YES=0; JSON=0; ALL=0; EVENTS_DIR=""; ONLY=""; EULA=""; REUSE_X=0; REEXTRACT=0; FLAG_ERR=""; SIG_GOT=""; END_DONE=0
WRITE=0; SERVER=""; TIER=""; TOKEN_NAME=""   # ./revit mcp: --write (refused), --server, and for its token: --tier, --name
DRY=0; LOG=0; KEEP=0   # --dry-run: remove and rebuild only. ./revit test: --log, and --keep (the maintainer's, not in the help)
TARGETS=""   # ./revit cleanup: --targets <pid>:<start>,… (the app: what the person approved)
RUN_ARG=""; EXCL=()   # ./revit report: --run <log_dir>, --exclude <file> (again for more files)
WARM_OPTS=()   # ./revit gdrive warm: --depth N, --max N
NO_POINT=0; POINT_TO=""; POINT_CLEAR=""   # ./revit rebuild --no-point, rollback --to <id>, points --clear old|all
OPEN_BOTTLE=""; COPY_FOR=""   # ./revit open --bottle <bottle>, --copy-for <year>
RESULT_HINT=usage   # what an exit before the child means: usage until the arguments check out (Task 5 reads it)
sup_end() { # $1 = exit status: the one end event, from the child's result file or from what an early exit means
  [ "$END_DONE" = 0 ] || return 0; END_DONE=1
  [ -n "${REVIT_EVENTS_FD:-}" ] || return 0
  local f="$REVIT_RUN_CTX/result" r fa fs ld rs steps="" s
  r="$(sed -n 's/^result=//p' "$f" 2>/dev/null)"; fa="$(sed -n 's/^failed_action=//p' "$f" 2>/dev/null)"
  fs="$(sed -n 's/^failed_steps=//p' "$f" 2>/dev/null)"; ld="$(sed -n 's/^log_dir=//p' "$f" 2>/dev/null)"
  rs="$(sed -n 's/^reason=//p' "$f" 2>/dev/null)"   # why it failed (no_space, download), when a script knew
  if [ -z "$r" ]; then
    if [ "$1" -gt 128 ]; then r=stopped; elif [ "$1" = 0 ]; then r=ok; else r="$RESULT_HINT"; fi
  fi
  for s in $fs; do steps+="${steps:+,}$(json_str "$s")"; done
  printf '{"event":"end","exit_code":%s,"result":%s,"failed_action":%s,"failed_steps":[%s],"log_dir":%s%s}\n' \
    "$1" "$(json_str "$r")" "$(json_str "$fa")" "$steps" "$(json_str "$ld")" "${rs:+,\"reason\":$(json_str "$rs")}" | emit_line end
}
run_ctx_new() { # the run context: the result (and the events, Task 5) of this command, in $DATA/logs/runs/<run_id>/
  [ -n "${REVIT_RUN_CTX:-}" ] && return 0   # --events gave one
  REVIT_RUN_ID="$(date +%Y%m%d-%H%M%S)-$$"; REVIT_RUN_CTX="$DATA/logs/runs/$REVIT_RUN_ID"
  mkdir -p "$REVIT_RUN_CTX" || die "Cannot create a log folder in $(tilde "$DATA/logs")."
  export REVIT_RUN_ID REVIT_RUN_CTX
}
not_busy() { lock_free || { RESULT_HINT=busy; die "Another task is running: $(lock_owner). Wait until it finishes, then try again."; }; }
supervise() { # <command…>: runs it in the foreground of this process group (Ctrl-C reaches it as when this script
  # exec'ed it) and ends as it did: the same exit code, or death by the same signal
  local rc sig=""
  if [ -n "$SIG_GOT" ]; then   # a signal came before the child: do not start it
    result_set result stopped; sup_end 1; trap - "$SIG_GOT"; kill -"$SIG_GOT" $$; exit 1
  fi
  # bash reports a foreground child killed by TERM/HUP ("Terminated: 15") on its own stderr; exec'ing, it did not:
  # the child keeps the real stderr (fd 8), this shell's goes to /dev/null while it waits
  case "$CMD" in install|rebuild|addins|test)   # no sleep while it works; ends with this process, holds no lock or events fd
    command -v caffeinate >/dev/null && caffeinate -i -w $$ </dev/null >/dev/null 2>&1 7>&- 9>&- & ;;
  esac
  exec 8>&2 2>/dev/null
  "$@" 2>&8 8>&-; rc=$?
  exec 2>&8 8>&-
  [ "$rc" -gt 128 ] && sig="$(kill -l $((rc - 128)) 2>/dev/null)"
  sup_end "$rc"
  if [ -n "$sig" ]; then trap - "$sig"; kill -"$sig" $$; fi
  exit "$rc"
}

usage() {
  cat <<'EOF'
Usage: ./revit <command> <year> [bottle]

  install   install Revit
  check     check what the install needs, change nothing
  doctor    check an installed Revit, its bottle and this Mac, change nothing (no year: this Mac and CrossOver)
  report    make a report for a GitHub issue, with personal data removed (no year: this Mac and the last runs)
  addins    add RevitLookup and pyRevit (--only <add-ins>; ./revit addins list <year>)
  gdrive    list folders on G: ahead, so Revit's Open dialog does not wait (gdrive warm <year> [bottle] <folder>)
  set       turn Retina display and Mac keys on or off, fix or free the theme (2020, 2027; theme: 2027), set up G: from Google Drive
  import    add a file the install needs from your Windows PC (import msls31 <file>)
  cache     show or clear downloaded and unpacked installer files (cache clear --yes)
  stop      quit a Revit that hangs
  open      open a file in the Revit it was saved in (open <file>, no year; never upgrades it: --copy-for <year> opens a copy)
  cleanup   close programs Wine or the app left running (no year: every bottle; --dry-run lists them; --all closes
            all of Wine, Revit too, without saving; --targets <pid>:<start>,… only those of them)
  logs      list the newest logs
  debug     start Revit and record a log
  mcp       connect an AI assistant to a running Revit (--server pyrevit|python; docs/mcp.md); first give it a token:
            mcp token <year> [bottle] [--tier read|write|code] [--name n], mcp bundle <year> for Claude Desktop,
            mcp tokens (list), mcp revoke <name>
  hittest   for the app: the Windows window under a point (stdin/stdout)
  theme     for the app: Revit's theme follows the Mac's light or dark look now
  rebuild   keep a restore point, delete the bottle and install Revit again (--no-point: keep none)
  rollback  bring the bottle back from its restore point (--to <id>: an older one)
  points    list the restore points of a bottle (--clear old|all deletes them)
  remove    delete Revit, its bottle and its apps
  status    list the Revit bottles on this Mac (no year)
  find-installer  say which Revit installer a folder holds (a folder, no year)
  link-installer  use an installer folder anywhere on this Mac (a year and a folder)

Example: ./revit install 2025
Each Revit year lives in its own bottle, rvt<year>-a. To use another bottle, add its name at the end.
EOF
}
size() { du -sh "$1" 2>/dev/null | cut -f1; }
bytes_of() { local k; k="$(du -sk "$1" 2>/dev/null | cut -f1)"; [[ "$k" =~ ^[0-9]+$ ]] && echo $((k * 1024)) || echo null; }

ARGC=$#; POS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --yes) YES=1 ;;
    --json) JSON=1 ;;
    --all) ALL=1 ;;
    --reuse-extracted) REUSE_X=1 ;;
    --reextract) REEXTRACT=1 ;;
    --dry-run) DRY=1 ;;
    --log) LOG=1 ;;
    --keep) KEEP=1 ;;
    --write) WRITE=1 ;;
    --no-point) NO_POINT=1 ;;
    --events|--only|--accept-eula|--run|--exclude|--server|--tier|--name|--targets|--depth|--max|--to|--clear|--bottle|--copy-for)
      if [ $# -lt 2 ]; then FLAG_ERR="$1 needs a value"
      else case "$1" in --events) EVENTS_DIR="$2" ;; --only) ONLY="$2" ;; --accept-eula) EULA="$2" ;;
        --run) RUN_ARG="$2" ;; --exclude) EXCL+=("$2") ;; --server) SERVER="$2" ;; --tier) TIER="$2" ;; --name) TOKEN_NAME="$2" ;; --depth|--max) WARM_OPTS+=("$1" "$2") ;; --targets) TARGETS="$2" ;; --to) POINT_TO="$2" ;; --clear) POINT_CLEAR="$2" ;; --bottle) OPEN_BOTTLE="$2" ;; --copy-for) COPY_FOR="$2" ;; esac; shift; fi ;;
    -h|--help) POS+=(help) ;;
    --*) FLAG_ERR="Unknown option: $1" ;;
    *) POS+=("$1") ;;
  esac
  shift
done
CMD="${POS[0]:-}"; YEAR_ARG="${POS[1]:-}"; NAME="${POS[2]:-}"
MCPSUB=""   # ./revit mcp token|bundle|tokens|revoke
if [ "$CMD" = mcp ]; then
  case "$YEAR_ARG" in
    token|bundle|tokens|revoke) MCPSUB="$YEAR_ARG"; POS=(mcp ${POS[@]+"${POS[@]:2}"}); YEAR_ARG="${POS[1]:-}"; NAME="${POS[2]:-}" ;;
  esac
fi
GPATH=""   # ./revit gdrive warm <year> [bottle] <folder> [--depth N] [--max N]: the folder (WARM_OPTS: the options)
[ ${#WARM_OPTS[@]} = 0 ] || [ "$CMD" = gdrive ] || FLAG_ERR="--depth and --max are for ./revit gdrive warm only."
if [ "$CMD" = gdrive ]; then
  [ "${POS[1]:-}" = warm ] && [ ${#POS[@]} -ge 4 ] && [ ${#POS[@]} -le 5 ] \
    || usage_die "Usage: ./revit gdrive warm <year> [bottle] <folder on G: or in Google Drive> [--depth N] [--max N]"
  YEAR_ARG="${POS[2]}"; NAME=""; GPATH="${POS[${#POS[@]}-1]}"; [ ${#POS[@]} = 5 ] && NAME="${POS[3]}"
fi
SETS=()   # ./revit set: the words with "=" are settings, the one without is the bottle (bottle names have no "=")
if [ "$CMD" = set ]; then
  NAME=""
  for w in ${POS[@]+"${POS[@]:2}"}; do
    case "$w" in
      *=*) SETS+=("$w") ;;
      *) if [ -z "$NAME" ]; then NAME="$w"; else FLAG_ERR="Too many arguments. Example: ./revit set 2027 [bottle] retina=off"; fi ;;
    esac
  done
fi
[ "$REUSE_X$REEXTRACT" != 11 ] || FLAG_ERR="Use --reuse-extracted or --reextract, not both."
[ "$LOG" = 0 ] || [ "$CMD" = test ] || FLAG_ERR="--log is for ./revit test only."
[ "$DRY" = 0 ] || [ "$CMD" = remove ] || [ "$CMD" = rebuild ] || [ "$CMD" = cleanup ] || [ "$CMD" = rollback ] || [ "$CMD" = points ] || [ "$CMD" = open ] \
  || FLAG_ERR="--dry-run is for ./revit remove, rebuild, rollback, points, cleanup and open only."
[ -z "$OPEN_BOTTLE$COPY_FOR" ] || [ "$CMD" = open ] || FLAG_ERR="--bottle and --copy-for are for ./revit open only."
if [ "$CMD" = open ]; then
  [ ${#POS[@]} = 2 ] || FLAG_ERR="Usage: ./revit open <file> [--bottle <bottle>] [--copy-for <year>]"
  [ "$DRY" = "$JSON" ] || FLAG_ERR="--dry-run and --json go together for ./revit open."
  [ "$DRY" = 0 ] || [ -z "$COPY_FOR" ] || FLAG_ERR="--copy-for makes a copy: it is not for --dry-run."
  [ -z "$COPY_FOR" ] || [[ "$COPY_FOR" =~ ^[0-9]{4}$ ]] || FLAG_ERR="--copy-for takes a Revit year."
fi
[ "$NO_POINT" = 0 ] || [ "$CMD" = rebuild ] || FLAG_ERR="--no-point is for ./revit rebuild only."
[ -z "$POINT_TO" ] || [ "$CMD" = rollback ] || FLAG_ERR="--to is for ./revit rollback only."
[ -z "$POINT_TO" ] || [[ "$POINT_TO" =~ ^[0-9]{8}-[0-9]{6}$ ]] || FLAG_ERR="--to takes a restore point as ./revit points lists it."
[ -z "$POINT_CLEAR" ] || [ "$CMD" = points ] || FLAG_ERR="--clear is for ./revit points only."
[ -z "$POINT_CLEAR" ] || [ "$POINT_CLEAR" = old ] || [ "$POINT_CLEAR" = all ] || FLAG_ERR="--clear is old (all but the newest) or all."
[ "$KEEP" = 0 ] || [ "$CMD" = test ] || FLAG_ERR="Unknown option: --keep"
[ -z "$RUN_ARG" ] || [ "$CMD" = report ] || FLAG_ERR="--run is for ./revit report only."
[ ${#EXCL[@]} = 0 ] || [ "$CMD" = report ] || FLAG_ERR="--exclude is for ./revit report only."
[ "$WRITE" = 0 ] || [ "$CMD" = mcp ] || FLAG_ERR="Unknown option: --write"
[ -z "$TIER$TOKEN_NAME" ] || [ "$MCPSUB" = token ] || [ "$MCPSUB" = bundle ] || FLAG_ERR="--tier and --name are for ./revit mcp token and bundle only."
[ -z "$SERVER" ] || [ "$CMD" = mcp ] || FLAG_ERR="--server is for ./revit mcp only."
[ -z "$TARGETS" ] || [ "$CMD" = cleanup ] || FLAG_ERR="--targets is for ./revit cleanup only."
[ -z "$TARGETS" ] || [[ "$TARGETS" =~ ^[0-9]+:[0-9]+(,[0-9]+:[0-9]+)*$ ]] || FLAG_ERR="--targets takes <pid>:<start>,… as cleanup --dry-run --json lists them."
if [ "$CMD" = mcp ]; then   # stdout belongs to the MCP client: no events, no more words than year and bottle
  [ ${#POS[@]} -le 3 ] || FLAG_ERR="Too many arguments. Example: ./revit mcp 2027 [bottle]"
  case "$MCPSUB" in
    tokens) [ ${#POS[@]} = 1 ] || FLAG_ERR="Too many arguments. Example: ./revit mcp tokens" ;;
    revoke) [ ${#POS[@]} -le 2 ] || FLAG_ERR="Too many arguments. Example: ./revit mcp revoke <name>" ;;
  esac
  [ -z "$EVENTS_DIR" ] || FLAG_ERR="--events is not for ./revit mcp."
  case "${SERVER:=autodesk}" in
    autodesk|pyrevit|python) ;;
    *) FLAG_ERR="Unknown MCP server: $SERVER. Known: autodesk, pyrevit, python" ;;
  esac
  [ "$WRITE" = 0 ] || FLAG_ERR="What a connection may do now comes with its token: ./revit mcp token ${YEAR_ARG:-<year>} --tier write (docs/mcp.md)."
fi
if [ "$CMD" = hittest ]; then   # the app's: stdout is the protocol; a year and a bottle, no options
  [ "$ARGC" = "${#POS[@]}" ] && [ ${#POS[@]} -le 3 ] && [[ "${POS[1]:-}" =~ ^[0-9]{4}$ ]] \
    || usage_die "Usage: ./revit hittest <year> [bottle] (for the app)"
fi
if [ "$CMD" = theme ]; then   # the app's: a year and a bottle, no options, no settings
  [ "$ARGC" = "${#POS[@]}" ] && [ ${#POS[@]} -le 3 ] && [[ "${POS[1]:-}" =~ ^[0-9]{4}$ ]] && [[ "${POS[2]:-}" != *=* ]] \
    || usage_die "Usage: ./revit theme <year> [bottle]"
fi
SUPERVISED=0; case "$CMD" in install|check|addins|rebuild|test|set) SUPERVISED=1 ;; esac
sup_traps() { # signals noted, not ignored (an ignored signal would be inherited by the child), from here to the child
  trap 'SIG_GOT=INT' INT; trap 'SIG_GOT=TERM' TERM; trap 'SIG_GOT=HUP' HUP
}
# Until then bash's default stays: Ctrl-C ends ./revit at once, also at the typed confirmation, as before. With
# --events (the app, which passes --yes) a supervised command notes signals from the start, so even an early
# cancel ends with one end event (Task 5)
if [ -n "$EVENTS_DIR" ]; then
  mkdir -p "$EVENTS_DIR" 2>/dev/null || die "Cannot create $EVENTS_DIR"
  # one folder, one run: the events file is created here or the folder is refused (atomic: O_EXCL)
  /usr/bin/perl -MFcntl -e 'sysopen(my $f, $ARGV[0], O_WRONLY | O_CREAT | O_EXCL) or exit 1' "$EVENTS_DIR/events.ndjson" \
    || die "$EVENTS_DIR already holds a run. Give each run a new folder."
  REVIT_RUN_CTX="$(cd "$EVENTS_DIR" && pwd)"; REVIT_RUN_ID="$(basename "$REVIT_RUN_CTX")"; export REVIT_RUN_ID REVIT_RUN_CTX
  rm -f "$REVIT_RUN_CTX/result" "$REVIT_RUN_CTX/.ended"
  exec 7>>"$REVIT_RUN_CTX/events.ndjson" || die "Cannot write $REVIT_RUN_CTX/events.ndjson"
  [ "$SUPERVISED" = 0 ] || sup_traps
  export REVIT_EVENTS_FD=7
  trap 'sup_end $?' EXIT
  y=null; b=null   # the year as a number and the bottle with its default, when the arguments allow them
  if [[ "$YEAR_ARG" =~ ^[0-9]{4}$ ]]; then y="$((10#$YEAR_ARG))"; b="$(json_str "${NAME:-$(revit_bottle_default "$YEAR_ARG")}")"
  elif [ -n "$NAME" ]; then b="$(json_str "$NAME")"; fi
  emit start run_id "$(json_str "$REVIT_RUN_ID")" command "$(json_str "$CMD")" year "$y" bottle "$b" pid "$$"
fi
[ -z "$FLAG_ERR" ] || die "$FLAG_ERR"
case "$MCPSUB" in   # no year, no bottle to check
  tokens) exec python3 -I -B "$ROOT/tools/mcp_gate.py" token-list --data "$DATA" ;;
  revoke) [ -n "$YEAR_ARG" ] || die "Usage: ./revit mcp revoke <name> (./revit mcp tokens lists them)"
    exec python3 -I -B "$ROOT/tools/mcp_gate.py" token-revoke --data "$DATA" --name "$YEAR_ARG" ;;
esac
case "$CMD" in
  install|check|doctor|report|addins|import|cache|stop|cleanup|logs|debug|rebuild|remove|status|find-installer|link-installer|test|mcp|set|hittest|theme|gdrive|rollback|points|open) ;;
  ""|help|-h|--help) usage; exit 0 ;;
  *) echo "Unknown command: $CMD" >&2; echo >&2; usage >&2; exit 1 ;;
esac
# a file, not a year: Mac files and our own lock, none of the checks below
[ "$CMD" != open ] || exec "$ROOT/scripts/open-file.sh" "$YEAR_ARG" "$OPEN_BOTTLE" "$COPY_FOR" "$DRY"
. "$ROOT/scripts/lib/addins.sh"
. "$ROOT/scripts/lib/points.sh"
status_addins() { # $1 = bottle path, $2 = year: the ids of the add-ins installed there, as JSON strings
  local id out="" B="$1" YEAR="$2"
  for id in ${ADDIN_IDS[@]+"${ADDIN_IDS[@]}"}; do
    addin_load "$id" && addin_is_installed && out+="${out:+,}$(json_str "$id")"
  done
  printf '%s' "$out"
}
if [ "$CMD" = status ]; then
  RESULT_HINT=failed
  b_json=""; human=""
  for b in "$BOTTLES"/*/; do
    b="${b%/}"; [ -L "$b" ] && continue; is_smoke_clone "$b" && continue   # a copy of ./revit test is no bottle
    ys="$(bottle_years "$b" | sort -u | tr '\n' ' ')"; ys="${ys% }"
    case "$ys" in [0-9][0-9][0-9][0-9]) ;; *) continue ;; esac   # one Revit year, or not ours
    tm="$(head -1 "$b/drive_c/Program Files/revit-macos/theme" 2>/dev/null)"   # the step theme's mode
    case "$tm" in mac|light|dark) ;; *) tm="" ;; esac
    gd="$(python3 -I "$ROOT/tools/gdrive.py" state "$b" 2>/dev/null)" || gd=null   # G:: no email, no folder names
    n="$(basename "$b")"; rv=false; [ -f "$(revit_dir_unix "$b" "$ys")/Revit.exe" ] && rv=true
    pids="$(revit_pids "$b" "$ys" | paste -sd, -)"; run_=false; [ -z "$pids" ] || run_=true
    b_json+="${b_json:+,}{\"name\":$(json_str "$n"),\"year\":$(json_str "$ys"),\"revit\":$rv,\"running\":$run_,\"revit_pids\":[$pids],\"addins\":[$(status_addins "$b" "$ys")],\"theme_mode\":$(json_str "$tm"),\"gdrive\":$gd}"
    human+="$(printf '  %-14s Revit %s%s' "$n" "$ys" "$([ $run_ = true ] && echo ', running')")"$'\n'
  done
  p_json=""; p_left=""; p_human=""   # restore points, of bottles that are gone too; sizes from point.conf: status runs often
  while IFS= read -r n; do
    [ -n "$n" ] || continue
    c=0; tb=0; extra=""
    while IFS= read -r id; do
      [ -n "$id" ] || continue
      d="$(points_dir "$n")/$id"; by="$(point_get "$d" bytes)"; [[ "$by" =~ ^[0-9]+$ ]] || by=0
      c=$((c + 1)); tb=$((tb + by))
      p_json+="${p_json:+,}{\"bottle\":$(json_str "$n"),\"year\":$(json_str "$(point_get "$d" year)"),\"id\":$(json_str "$id"),\"time\":$(json_str "$(point_get "$d" time)"),\"bytes\":$by}"
    done <<<"$(points_ids "$n" "")"
    if [ -n "$(points_leftovers "$n")" ]; then extra=", unfinished files"; p_left+="${p_left:+,}$(json_str "$n")"; fi
    [ "$c" = 0 ] && [ -z "$extra" ] && continue
    p_human+="Restore points: $n $c (up to $(points_gb "$tb") GB$extra)"$'\n'
  done <<<"$(points_names)"
  busy=false; lock_free || busy=true
  if [ "$JSON" = 1 ]; then
    cxf=false; [ -x "$CX/bin/cxbottle" ] && cxf=true; ros=false; /usr/bin/arch -x86_64 /usr/bin/true 2>/dev/null && ros=true
    cxv="$(crossover_version)"; cxs=false   # supported: the major version the status words were earned on
    [ "$cxf" = true ] && [ -n "$cxv" ] && [ "${cxv%%.*}" = "${CX_TESTED%%.*}" ] && cxs=true
    ms=false; [ -f "$DATA/installers/redist/win7sp1/x64/msls31.dll" ] && ms=true
    printf '{"crossover":{"found":%s,"path":%s,"version":%s,"supported":%s},"rosetta":%s,"msls31":%s,' \
      "$cxf" "$(json_str "$CX")" "$(json_str "$cxv")" "$cxs" "$ros" "$ms"
    printf '"busy":{"busy":%s,"command":%s,"run_id":%s,"pid":%s,"pid_start":%s,"pgid":%s,"ctx":%s},' "$busy" \
      "$(json_str "$([ $busy = true ] && lock_owner)")" "$(json_str "$(lock_owner_field run_id)")" "$(json_str "$(lock_owner_field pid)")" \
      "$(json_str "$(lock_owner_field pid_start)")" "$(json_str "$(lock_owner_field pgid)")" "$(json_str "$(lock_owner_field ctx)")"
    if ap="$(app_path)"; then   # only inside the app: a clone's JSON stays as it was
      printf '"app":{"name":%s,"version":%s,"path":%s,"placement":%s,"data":%s},' "$(json_str "$APP_NAME")" \
        "$(json_str "$(sed -n 's/^app_version=//p' "$ROOT/.app-bundle")")" "$(json_str "$ap")" "$(json_str "$(app_placement "$ap")")" \
        "$(json_str "$DATA")"
    fi
    printf '"restore_points":[%s],"restore_leftovers":[%s],"bottles":[%s]}\n' "$p_json" "$p_left" "$b_json"
  else
    [ -n "$human" ] && printf '%s' "$human" || echo "No Revit bottles yet. To install one: ./revit install <year>"
    if [ -n "$p_human" ]; then printf '%s' "$p_human"; echo "To see or delete them: ./revit points <year> [bottle] --clear old|all"; fi
    [ $busy = false ] || echo "Busy: $(lock_owner)"
  fi
  exit 0
fi
if [ "$CMD" = cache ]; then   # downloaded and unpacked installer files that can be deleted (the app's Settings); no year
  [ -z "$YEAR_ARG" ] || [ "$YEAR_ARG" = clear ] || die "Usage: ./revit cache [--json], ./revit cache clear --yes"
  RESULT_HINT=failed
  cache_inputs() { # what an installer reads: "R <real folder>" for each installers/revit<year>, and "P <path>" for every
    # path met while resolving each entry under it (each link's own path, each folder on the way, the end): deleting any of
    # these would break that installer, also through a link inside a downloads folder
    local y L rf
    for y in "${REVIT_SUPPORTED[@]}"; do
      L="$(revit_input "$y")"; [ -e "$L" ] || continue
      rf="$(cd -P "$L" 2>/dev/null && pwd)" || continue; echo "R $rf"
      find -L "$L" -maxdepth 3 2>/dev/null | /usr/bin/perl -ne 'chomp; my @todo = grep { length } split m{/}; my ($cur, $n) = ("", 0);
        while (@todo) { my $c = shift @todo; next if $c eq "."; if ($c eq "..") { $cur =~ s{/[^/]*$}{}; next }
          my $next = "$cur/$c"; print "P $next\n";
          if (-l $next) { last if ++$n > 40; my $t = readlink $next; $cur = "" if $t =~ m{^/}; unshift @todo, grep { length } split m{/}, $t; next }
          $cur = $next }
        print "P $cur\n"'
    done
  }
  cache_kept() { # $1 = a candidate folder: "your installer folder" when an installer reads it or anything in it
    local rc kind p
    rc="$(cd -P "$1" 2>/dev/null && pwd)" || return 0
    while read -r kind p; do
      case "$kind" in
        P) if [ "$p" = "$rc" ] || [[ "$p" == "$rc"/* ]]; then echo "your installer folder"; return 0; fi ;;
        R) if [ "$p" = "$rc" ] || [[ "$rc" == "$p"/* ]]; then echo "your installer folder"; return 0; fi ;;
      esac
    done <<<"$C_INPUTS"
  }
