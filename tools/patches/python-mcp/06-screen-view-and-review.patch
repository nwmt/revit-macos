+# A person reads this: their language as it is, and as escapes only what could hide or reorder text on screen.
+HIDDEN = re.compile(u"[\x00-\x08\x0b-\x1f\x7f-\xa0\xad\u200b-\u200f\u2028-\u202f\u205f-\u206f\ufeff\ufff9-\ufffb]")
