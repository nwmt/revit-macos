pe_dll64() { # $1 = file: a 64-bit Windows DLL (PE32+, x64), its whole declared header inside the file
  /usr/bin/perl -e 'open(my $f, "<", $ARGV[0]) or exit 1; binmode $f; local $/; my $d = <$f>; my $n = length $d;
    exit 1 if $n < 0x40 || substr($d, 0, 2) ne "MZ"; my $e = unpack("V", substr($d, 0x3c, 4));
    exit 1 if $e + 26 > $n || substr($d, $e, 4) ne "PE\0\0";
    my ($m, $ns, undef, undef, undef, $so, $ch) = unpack("vvVVVvv", substr($d, $e + 4, 20)); my $mg = unpack("v", substr($d, $e + 24, 2));
    exit !($m == 0x8664 && $ns >= 1 && $so >= 112 && ($ch & 0x2000) && $mg == 0x20b && $e + 24 + $so + 40 * $ns <= $n)' "$1"
}
