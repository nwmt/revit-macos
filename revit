#!/usr/bin/env bash
# Everyday commands for Revit on this Mac: ./revit <command> <year> [bottle]. Run ./revit for the list.
# A thin front for install.sh and scripts/: it checks the arguments, refuses to touch the wrong or a busy bottle, and
# asks before deleting anything. REVIT_CX (tests only) points at a fake CrossOver.
set -uo pipefail
ROOT="$(cd "$(dirname "$0")" && pwd)"; . "$ROOT/scripts/lib/common.sh"
YES=0; JSON=0; EVENTS_DIR=""; ONLY=""; EULA=""; REUSE_X=0; REEXTRACT=0; FLAG_ERR=""; SIG_GOT=""; END_DONE=0
RESULT_HINT=usage   # what an exit before the child means: usage until the arguments check out (Task 5 reads it)
sup_end() { # $1 = exit status: the one end event, from the child's result file or from what an early exit means
  [ "$END_DONE" = 0 ] || return 0; END_DONE=1
  [ -n "${REVIT_EVENTS_FD:-}" ] || return 0
  local f="$REVIT_RUN_CTX/result" r fa fs ld steps="" s
  r="$(sed -n 's/^result=//p' "$f" 2>/dev/null)"; fa="$(sed -n 's/^failed_action=//p' "$f" 2>/dev/null)"
  fs="$(sed -n 's/^failed_steps=//p' "$f" 2>/dev/null)"; ld="$(sed -n 's/^log_dir=//p' "$f" 2>/dev/null)"
  if [ -z "$r" ]; then
    if [ "$1" -gt 128 ]; then r=stopped; elif [ "$1" = 0 ]; then r=ok; else r="$RESULT_HINT"; fi
  fi
  for s in $fs; do steps+="${steps:+,}$(json_str "$s")"; done
  printf '{"event":"end","exit_code":%s,"result":%s,"failed_action":%s,"failed_steps":[%s],"log_dir":%s}\n' \
    "$1" "$(json_str "$r")" "$(json_str "$fa")" "$steps" "$(json_str "$ld")" | emit_line end
}
run_ctx_new() { # the run context: the result (and the events, Task 5) of this command, in $DATA/logs/runs/<run_id>/
  [ -n "${REVIT_RUN_CTX:-}" ] && return 0   # --events gave one
  REVIT_RUN_ID="$(date +%Y%m%d-%H%M%S)-$$"; REVIT_RUN_CTX="$DATA/logs/runs/$REVIT_RUN_ID"
  mkdir -p "$REVIT_RUN_CTX" || die "Cannot create a log folder in $(tilde "$DATA/logs")."
  export REVIT_RUN_ID REVIT_RUN_CTX
}
supervise() { # <command…>: runs it in the foreground of this process group (Ctrl-C reaches it as when this script
  # exec'ed it) and ends as it did: the same exit code, or death by the same signal
  local rc sig=""
  if [ -n "$SIG_GOT" ]; then   # a signal came before the child: do not start it
    result_set result stopped; sup_end 1; trap - "$SIG_GOT"; kill -"$SIG_GOT" $$; exit 1
  fi
  # bash reports a foreground child killed by TERM/HUP ("Terminated: 15") on its own stderr; exec'ing, it did not:
  # the child keeps the real stderr (fd 8), this shell's goes to /dev/null while it waits
  case "$CMD" in install|rebuild|addins)   # no sleep while it works; ends with this process, holds no lock or events fd
    command -v caffeinate >/dev/null && caffeinate -i -w $$ </dev/null >/dev/null 2>&1 7>&- 9>&- & ;;
  esac
  exec 8>&2 2>/dev/null
  "$@" 2>&8 8>&-; rc=$?
  exec 2>&8 8>&-
  [ "$rc" -gt 128 ] && sig="$(kill -l $((rc - 128)) 2>/dev/null)"
  sup_end "$rc"
  if [ -n "$sig" ]; then trap - "$sig"; kill -"$sig" $$; fi
  exit "$rc"
}

usage() {
  cat <<'EOF'
Usage: ./revit <command> <year> [bottle]

  install   install Revit
  check     check what the install needs, change nothing
  addins    add RevitLookup and pyRevit
  stop      quit a Revit that hangs
  logs      list the newest logs
  debug     start Revit and record a log
  rebuild   delete the bottle and install Revit again
  remove    delete Revit, its bottle and its apps

Example: ./revit install 2025
Each Revit year lives in its own bottle, rvt<year>-a. To use another bottle, add its name at the end.
EOF
}
cx_launchers() { # apps CrossOver makes for the bottle's Start Menu entries; deleting the bottle leaves them behind
  local a
  find "$HOME/Applications/CrossOver" -type d -name '*.app' -prune 2>/dev/null | while IFS= read -r a; do
    [ "$(plutil -extract CXHelperAppBottleName raw -o - "$a/Contents/Info.plist" 2>/dev/null)" = "$NAME" ] && echo "$a"
  done
}
size() { du -sh "$1" 2>/dev/null | cut -f1; }

POS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --yes) YES=1 ;;
    --json) JSON=1 ;;
    --reuse-extracted) REUSE_X=1 ;;
    --reextract) REEXTRACT=1 ;;
    --events|--only|--accept-eula)
      if [ $# -lt 2 ]; then FLAG_ERR="$1 needs a value"
      else case "$1" in --events) EVENTS_DIR="$2" ;; --only) ONLY="$2" ;; --accept-eula) EULA="$2" ;; esac; shift; fi ;;
    -h|--help) POS+=(help) ;;
    --*) FLAG_ERR="Unknown option: $1" ;;
    *) POS+=("$1") ;;
  esac
  shift
done
CMD="${POS[0]:-}"; YEAR_ARG="${POS[1]:-}"; NAME="${POS[2]:-}"
[ "$REUSE_X$REEXTRACT" != 11 ] || FLAG_ERR="Use --reuse-extracted or --reextract, not both."
SUPERVISED=0; case "$CMD" in install|check|addins|rebuild) SUPERVISED=1 ;; esac
sup_traps() { # signals noted, not ignored (an ignored signal would be inherited by the child), from here to the child
  trap 'SIG_GOT=INT' INT; trap 'SIG_GOT=TERM' TERM; trap 'SIG_GOT=HUP' HUP
}
# Until then bash's default stays: Ctrl-C ends ./revit at once, also at the typed confirmation, as before. With
# --events (the app, which passes --yes) a supervised command notes signals from the start, so even an early
# cancel ends with one end event (Task 5)
if [ -n "$EVENTS_DIR" ]; then
  mkdir -p "$EVENTS_DIR" 2>/dev/null || die "Cannot create $EVENTS_DIR"
  # one folder, one run: the events file is created here or the folder is refused (atomic: O_EXCL)
  /usr/bin/perl -MFcntl -e 'sysopen(my $f, $ARGV[0], O_WRONLY | O_CREAT | O_EXCL) or exit 1' "$EVENTS_DIR/events.ndjson" \
    || die "$EVENTS_DIR already holds a run. Give each run a new folder."
  REVIT_RUN_CTX="$(cd "$EVENTS_DIR" && pwd)"; REVIT_RUN_ID="$(basename "$REVIT_RUN_CTX")"; export REVIT_RUN_ID REVIT_RUN_CTX
  rm -f "$REVIT_RUN_CTX/result" "$REVIT_RUN_CTX/.ended"
  exec 7>>"$REVIT_RUN_CTX/events.ndjson" || die "Cannot write $REVIT_RUN_CTX/events.ndjson"
  [ "$SUPERVISED" = 0 ] || sup_traps
  export REVIT_EVENTS_FD=7
  trap 'sup_end $?' EXIT
  y=null; b=null   # the year as a number and the bottle with its default, when the arguments allow them
  if [[ "$YEAR_ARG" =~ ^[0-9]{4}$ ]]; then y="$YEAR_ARG"; b="$(json_str "${NAME:-$(revit_bottle_default "$YEAR_ARG")}")"
  elif [ -n "$NAME" ]; then b="$(json_str "$NAME")"; fi
  emit start run_id "$(json_str "$REVIT_RUN_ID")" command "$(json_str "$CMD")" year "$y" bottle "$b" pid "$$"
fi
[ -z "$FLAG_ERR" ] || die "$FLAG_ERR"
case "$CMD" in
  install|check|addins|stop|logs|debug|rebuild|remove) ;;
  ""|help|-h|--help) usage; exit 0 ;;
  *) echo "Unknown command: $CMD" >&2; echo >&2; usage >&2; exit 1 ;;
esac
[ -n "$YEAR_ARG" ] || die "Which Revit year? Example: ./revit $CMD 2025"
if ! load_profile "$YEAR_ARG"; then
  [[ "$YEAR_ARG" =~ ^[0-9]{4}$ ]] || die "\"$YEAR_ARG\" is not a Revit year. Example: ./revit $CMD 2025"
  die "Revit $YEAR_ARG is not supported yet. Supported: ${REVIT_SUPPORTED[*]}."
fi
DEFAULT="$(revit_bottle_default "$YEAR")"; NAME="${NAME:-$DEFAULT}"
revit_bottle_name_ok "$NAME" || die "Bottle name may contain only letters, digits, - and _, and cannot be \"default\": \"$NAME\""
RESULT_HINT=failed
B="$(bottle_path "$NAME")"; SFX="$(bottle_sfx "$NAME" "$YEAR")"

need_crossover() {
  [ -x "$CX/bin/cxbottle" ] && [ -x "$CX/bin/wineserver" ] \
    || die "CrossOver not found in /Applications. Install it from https://www.codeweavers.com/crossover"
}
not_busy() { lock_free || { RESULT_HINT=busy; die "Another task is running: $(lock_owner). Wait until it finishes, then try again."; }; }
confirm() { # typing the year is harder to do by accident than y/n
  [ "$YES" = 1 ] && return 0
  local a=""; printf 'Type %s to continue, anything else to cancel: ' "$YEAR"
  read -r a || a=""
  [ -z "$SIG_GOT" ] || supervise true   # a signal noted while reading (events mode only) ends the run as stopped
  [ "$a" = "$YEAR" ] || { echo; echo "Cancelled. Nothing changed."; exit 1; }
}
docs_note() { # the bottle's Documents is normally a link to the Mac's Documents: deleting the bottle removes the link only
  local t
  if t="$(readlink "$B/drive_c/users/crossover/Documents")"; then
    echo "  Documents in this bottle is your Mac folder $(tilde "$t"). It stays."
  else
    echo "  Documents in this bottle is not linked to your Mac. Files in it are deleted too."
  fi
  echo "  Everything else on the bottle's C: drive is deleted."
}
extracted_plan() { # sets X, DROP_X (1 = remove deletes the unpacked files) and KEEP_X (why they stay)
  X="$(revit_extracted "$YEAR")"; DROP_X=0; KEEP_X=""
  [ -d "$X" ] || return 0
  if o="$(other_bottle_of_year)"; then KEEP_X="bottle $o still uses it"; else DROP_X=1; fi
}

# ---- run the command ----
case "$CMD" in
  install) not_busy; run_ctx_new; sup_traps; lock_take --no-trap "install.sh $YEAR $NAME"; supervise "$ROOT/install.sh" "$YEAR" "$NAME" ;;
  check)   export INSTALL_DRYRUN=1; run_ctx_new; sup_traps; supervise "$ROOT/install.sh" "$YEAR" "$NAME" ;;
  addins)
    [ ${#ADDIN_STEPS[@]} -gt 0 ] || die "The add-in script is not set up for Revit $YEAR yet."
    bottle_guard must_exist "$YEAR" "$NAME"; not_busy
    run_ctx_new; sup_traps; lock_take --no-trap "./revit addins $YEAR $NAME"; bottle_guard must_exist "$YEAR" "$NAME"
    export RUN_KIND=addins; supervise "$ROOT/scripts/run-steps.sh" "$YEAR" "$NAME" "${ADDIN_STEPS[@]}" ;;
  stop)
    need_crossover; bottle_guard running_ok "$YEAR" "$NAME"
    lock_take "./revit stop $YEAR $NAME"   # an install's Wine programs run in this bottle too: -k would end them
    bottle_guard running_ok "$YEAR" "$NAME"   # again, under the lock: the bottle may have changed meanwhile
    if ! WINEPREFIX="$B" "$CX/bin/wineserver" -k0 2>/dev/null 7>&- 9>&-; then echo "Nothing is running in $NAME."; exit 0; fi
    WINEPREFIX="$B" "$CX/bin/wineserver" -k 2>/dev/null 7>&- 9>&- || die "Could not stop $NAME. Quit CrossOver and try again."
    echo "Stopped Revit and everything else in $NAME. Start Revit again from ~/Applications." ;;
  logs)
    found="$(ls -td "$DATA/logs/$NAME"/*/ 2>/dev/null | head -8)"
    if [ -z "$found" ]; then
      ls -d "$DATA"/logs/*-"$NAME"-[0-9]* >/dev/null 2>&1 \
        && die "No logs for $NAME in logs/$NAME/ yet. Older logs are in logs/ directly: open \"$DATA/logs\""
      die "No logs for $NAME yet. ./revit install and ./revit debug write them to logs/$NAME/."
    fi
    echo "Newest logs for Revit $YEAR ($NAME), newest first:"
    while IFS= read -r f; do f="${f%/}"; echo "  logs/${f#"$DATA/logs/"}"; done <<<"$found"
    echo "Open the folder: open \"$DATA/logs/$NAME\""
    echo "To report a problem, see \"Report a problem\" in docs/troubleshooting.md." ;;
  debug)
    need_crossover; bottle_guard must_exist "$YEAR" "$NAME"; not_busy
    "$ROOT/scripts/launch.sh" "$YEAR" "$NAME" || exit 1
    echo "Make the problem happen, quit Revit, then run ./revit logs $YEAR$SFX." ;;
  rebuild)
    need_crossover; bottle_guard must_exist "$YEAR" "$NAME"; not_busy
    echo "This deletes the bottle $NAME and installs Revit $YEAR into it again (10–30 minutes)."
    echo "  Revit is installed from the files already in installers/extracted/revit$YEAR. To get a newer Revit update,"
    echo "  see \"Updating\" in the README."
    if [ ${#ADDIN_STEPS[@]} -gt 0 ]; then
      echo "  Revit settings and add-ins in this bottle are reset: run ./revit addins $YEAR$SFX again if you use them."
    else
      echo "  Revit settings in this bottle are reset."
    fi
    docs_note
    confirm
    run_ctx_new; sup_traps; lock_take --no-trap "./revit rebuild $YEAR $NAME"
    bottle_guard must_exist "$YEAR" "$NAME"   # again: the bottle may have changed, or Revit started, while the user read
    export CX_RECREATE=1; supervise "$ROOT/install.sh" "$YEAR" "$NAME" ;;
  remove)
    APPS=(); NA=0
    for a in "Revit $YEAR" "Revit Viewer $YEAR" "Autodesk Sign-In"; do
      [ -d "$HOME/Applications/$a ($NAME).app" ] && { APPS+=("$HOME/Applications/$a ($NAME).app"); NA=$((NA + 1)); }
    done
    CXAPPS=(); while IFS= read -r a; do CXAPPS+=("$a"); done < <(cx_launchers)
    if [ -d "$B" ]; then need_crossover; fi
    bottle_guard allow_missing "$YEAR" "$NAME"; not_busy
    extracted_plan
    HAD_B=0; [ -d "$B" ] && HAD_B=1
    if [ "$HAD_B" = 0 ] && [ "$NA" -eq 0 ] && [ ${#CXAPPS[@]} -eq 0 ] && [ "$DROP_X" = 0 ]; then echo "Nothing to remove for Revit $YEAR ($NAME)."; exit 0; fi
    echo "This deletes:"
    [ "$HAD_B" = 1 ] && printf '  %-48s %s\n' "bottle $NAME" "$(size "$B")"
    [ "$DROP_X" = 1 ] && printf '  %-48s %s\n' "installers/extracted/revit$YEAR (unpacked files)" "$(size "$X")"
    for a in ${APPS[@]+"${APPS[@]}"}; do echo "  $(tilde "$a")"; done
    [ ${#CXAPPS[@]} -eq 0 ] || echo "  ${#CXAPPS[@]} CrossOver menu apps of $NAME in ~/Applications/CrossOver"
    [ "$HAD_B" = 1 ] && docs_note
    echo "Kept: installers/revit$YEAR (your downloads)."
    [ -n "$KEEP_X" ] && echo "Kept: installers/extracted/revit$YEAR ($KEEP_X)."
    confirm
    lock_take "./revit remove $YEAR $NAME"
    # again, right before deleting: the bottle may have changed, or Revit started, while the user was reading
    bottle_guard allow_missing "$YEAR" "$NAME"
    # the second look may only shrink what was confirmed, never add to it
    [ "$HAD_B" = 1 ] || [ ! -e "$B" ] \
      || die "Bottle $NAME appeared while you were reading. Nothing was removed. Run ./revit remove $YEAR$SFX again."
    want_x="$DROP_X"; extracted_plan
    if [ "$want_x" = 1 ] && [ "$DROP_X" = 0 ]; then echo "Kept: installers/extracted/revit$YEAR ($KEEP_X)."; fi
    [ "$want_x" = 1 ] || DROP_X=0
    if [ -d "$B" ]; then
      # the bottle's services (Autodesk licensing) run for hours without Revit, and CrossOver does not delete a bottle
      # with programs in it: end them first (it fails when nothing runs, which is fine)
      WINEPREFIX="$B" "$CX/bin/wineserver" -k 2>/dev/null </dev/null 7>&- 9>&-
      "$CX/bin/cxbottle" --bottle "$NAME" --delete --force </dev/null 7>&- 9>&-
      [ -d "$B" ] && die "The bottle is still there: $(tilde "$B"). Nothing else was removed. Quit CrossOver and run ./revit remove $YEAR$SFX again."
    fi
    for a in ${APPS[@]+"${APPS[@]}"} ${CXAPPS[@]+"${CXAPPS[@]}"}; do
      rm -rf "$a" 2>/dev/null; [ ! -e "$a" ] || die "Could not delete $(tilde "$a"). Delete it in Finder, or run ./revit remove $YEAR$SFX again."
    done
    [ ${#CXAPPS[@]} -eq 0 ] || find "$HOME/Applications/CrossOver" -mindepth 1 -type d -empty -delete 2>/dev/null
    if [ "$DROP_X" = 1 ]; then
      rm -rf "$X" 2>/dev/null; [ ! -e "$X" ] || die "Could not delete installers/extracted/revit$YEAR. Delete it in Finder."
    fi
    echo "Removed Revit $YEAR ($NAME)." ;;
esac
