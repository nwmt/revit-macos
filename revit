        gdrive=auto|gdrive=off|gdrive=again) export REVIT_GDRIVE="$v"; list+=(gdrive); shown+=("$kv"); continue ;;
        gdrive=*@*.*) case "$v" in *[[:space:]]*|*@*@*) die "gdrive is auto, off, again or the email of a Google Drive account." ;; esac
          export REVIT_GDRIVE="$v"; list+=(gdrive); shown+=(gdrive=account); continue ;;
        gdrive=*) die "gdrive is auto, off, again or the email of a Google Drive account: ./revit set $YEAR$SFX gdrive=auto" ;;
        gdrive_names=*) n="$(python3 -I "$ROOT/tools/gdrive.py" names "$v" 2>&1 >/dev/null)" \
            || die "${n:-gdrive_names: not a valid value}"   # names the pair and the reason, never the value
          n="$(python3 -I "$ROOT/tools/gdrive.py" names "$v" | python3 -I -c 'import json, sys; print(sum(map(len, json.load(sys.stdin).values())))')"
          export REVIT_GDRIVE_NAMES="$v"; list+=(gdrive); shown+=("gdrive_names=$n names"); continue ;;
        retina=*) die "retina is on, compact or off: ./revit set $YEAR$SFX retina=off" ;;
        keys=*) die "keys is mac or windows: ./revit set $YEAR$SFX keys=windows" ;;
        theme=*) die "theme is mac (follow the Mac), light or dark: ./revit set $YEAR$SFX theme=dark" ;;
        *) die "Unknown setting: $k. Settings: retina, keys, theme, gdrive, gdrive_names" ;;
      esac
      shown+=("$kv")
    done
    [ "${REVIT_GDRIVE:-}" = again ] && [ -n "${REVIT_GDRIVE_NAMES+x}" ] && die "gdrive=again keeps the folder names: give gdrive_names without it."
    if in_list gdrive "${list[@]}"; then   # once, and first: Wine started by another setting would not list a new G:
      l2=(gdrive); for s in "${list[@]}"; do [ "$s" = gdrive ] || l2+=("$s"); done; list=("${l2[@]}")
    fi
    for s in "${list[@]}"; do   # each setting only where its step is in the profile (tested there)
      in_list "$s" ${STEPS[@]+"${STEPS[@]}"} && continue
      [ "$s" = gdrive ] && continue   # every profile has it; a bottle of an older profile gets it here
      [ "$s" = theme ] && die "The theme setting is for Revit 2027 only."
      die "Retina and Mac keys are tested on Revit 2020 and 2027 only."
    done
    need_crossover; bottle_guard must_exist "$YEAR" "$NAME"; not_busy
    if in_list gdrive "${list[@]}"; then   # Wine lists a drive only if it was there when its wineserver started
      [ "$(bottle_activity "$(bottle_path "$NAME")")" = stopped ] \
        || die "G: changes only while nothing runs in the bottle: quit Revit, then ./revit stop $YEAR$SFX and try again."
    fi
    echo "Revit $YEAR ($NAME): ${shown[*]}. Applies the next time Revit starts."
    in_list retina "${list[@]}" \
      && echo "The first start may open Revit's window at another size: maximize it, quit Revit and start it again."
    run_ctx_new; sup_traps; lock_take --no-trap "./revit set $YEAR $NAME"; bottle_guard must_exist "$YEAR" "$NAME"
    export RUN_KIND=steps; supervise "$ROOT/scripts/run-steps.sh" "$YEAR" "$NAME" "${list[@]}" ;;
  debug)
    need_crossover; bottle_guard must_exist "$YEAR" "$NAME"; not_busy
    "$ROOT/scripts/launch.sh" "$YEAR" "$NAME" || exit 1
    echo "Make the problem happen, quit Revit, then run ./revit report $YEAR$SFX." ;;
  rebuild)
    need_crossover; bottle_guard must_exist "$YEAR" "$NAME"; not_busy
    export_source_flags
    want_point=false; no_point_why=""   # a bottle with no Revit in it has nothing to keep
    if [ "$NO_POINT" = 0 ] && [ -f "$(revit_dir_unix "$B" "$YEAR")/Revit.exe" ]; then
      if point_why_not "$B" "$YEAR"; then
        want_point=true
        POINT_NOTE="A restore point is kept first: ./revit rollback $YEAR$SFX brings this bottle back. It keeps the old bottle's disk space until you delete it: ./revit points $YEAR$SFX."
      else
        no_point_why="$POINT_WHY"; POINT_NOTE="No restore point: $POINT_WHY. The old bottle cannot be brought back."
      fi
    fi
    if [ "$DRY$JSON" = 11 ]; then
      ar=false; [ ${#ADDIN_STEPS[@]} -gt 0 ] && ar=true
      printf '{"command":"rebuild","year":%s,"bottle":%s,"delete":[%s],"addins_reset":%s,"restore_point":%s,"notes":%s}\n' "$((10#$YEAR))" \
        "$(json_str "$NAME")" "$(item_json "bottle $NAME" "$(bytes_of "$B")")" "$ar" "$want_point" "$(notes_json)"
      exit 0
    fi
    echo "This deletes the bottle $NAME and installs Revit $YEAR into it again (10–30 minutes)."
    echo "  Revit is installed from the files already in installers/extracted/revit$YEAR. To get a newer Revit update,"
    echo "  see \"Updating\" in the README."
    if [ ${#ADDIN_STEPS[@]} -gt 0 ]; then
      echo "  Revit settings and add-ins in this bottle are reset: run ./revit addins $YEAR$SFX again if you use them."
    else
      echo "  Revit settings in this bottle are reset."
    fi
    docs_note
    [ "$DRY" = 0 ] || dry_end
    if [ -n "$no_point_why" ]; then
      if [ "$YES" = 1 ]; then   # no one read the line above: only --no-point says that is all right
        run_ctx_new; [ "$POINT_NO_SPACE" = 0 ] || result_set reason no_space
        die "No restore point: $no_point_why. Nothing was deleted. To rebuild without one: ./revit rebuild $YEAR$SFX --no-point"
      fi
      NO_POINT=1
    fi
    confirm
    run_ctx_new; sup_traps; lock_take --no-trap "./revit rebuild $YEAR $NAME"
    bottle_guard must_exist "$YEAR" "$NAME"   # again: the bottle may have changed, or Revit started, while the user read
    points_clean "$NAME" || die "Could not delete what an earlier run left in $(tilde "$(points_dir "$NAME")"). Delete it in Finder."
    if [ "$NO_POINT" = 0 ] && [ -f "$(revit_dir_unix "$B" "$YEAR")/Revit.exe" ]; then   # as things are now: what was promised holds or nothing happens
      if ! point_why_not "$B" "$YEAR"; then
        [ "$POINT_NO_SPACE" = 0 ] || result_set reason no_space
        die "No restore point: $POINT_WHY. Nothing was deleted. To rebuild without one: ./revit rebuild $YEAR$SFX --no-point"
      fi
      echo "Keeping a restore point of ${NAME}…"
      emit message level "$(json_str info)" text "$(json_str "Keeping a restore point of ${NAME}…")"
      point_take "$NAME" "$YEAR" "$B" || die "No restore point: $POINT_WHY. Nothing was deleted."
      if [ -n "$SIG_GOT" ]; then point_drop "$NAME" "$POINT_ID"; points_tidy "$NAME"; supervise true; fi
      echo "Restore point $POINT_ID kept."
    fi
    export CX_RECREATE=1; supervise "$ROOT/install.sh" "$YEAR" "$NAME" ;;
  rollback)
    [ -d "$B" ] && need_crossover
    bottle_guard allow_broken "$YEAR" "$NAME"; not_busy
    ids="$(points_ids "$NAME" "$YEAR")"
    [ -n "$ids" ] || die "There is no restore point of $NAME for Revit $YEAR."
    id="${POINT_TO:-$(head -n 1 <<<"$ids")}"
    grep -qx "$id" <<<"$ids" || die "No restore point $id. Restore points: $(tr '\n' ' ' <<<"$ids")"
    PD="$(points_dir "$NAME")/$id"
    [ "$(volume_id "$PD")" = "$(volume_id "$BOTTLES")" ] || die "Restore point $id is on another volume than the bottles. Nothing changed."
    echo "This brings bottle $NAME back as it was at $(point_get "$PD" time) (restore point $id)."
    [ ! -d "$B" ] || echo "  Everything in the bottle's C: drive that changed since then is deleted."
    echo "  The restore point stays."
    [ "$DRY" = 0 ] || dry_end
    confirm
    lock_take "./revit rollback $YEAR $NAME"
    bottle_guard allow_broken "$YEAR" "$NAME"   # again: Revit may have started while the user read
    grep -qx "$id" <<<"$(points_ids "$NAME" "$YEAR")" || die "Restore point $id is gone. Nothing changed."
    points_clean "$NAME" || die "Could not delete what an earlier run left in $(tilde "$(points_dir "$NAME")"). Delete it in Finder."
    IN="$(points_dir "$NAME")/restoring.$id"; OLD="$(points_dir "$NAME")/replaced.$id"
    mkdir "$IN" || die "Cannot write to $(tilde "$(points_dir "$NAME")")."
    run_child cp -cR "$PD/bottle/" "$IN"; rc=$?
    if [ $rc != 0 ] || [ "$STOP_REQUESTED" != 0 ] || [ ! -f "$IN/cxbottle.conf" ]; then
      point_rm "$IN"; stop_check; die "Could not copy the restore point. The bottle was not changed."
    fi
    bid_old=""
    if [ -d "$B" ]; then
      need_crossover; bid_old="$(sed -n 's/^"BottleID" = //p' "$B/cxbottle.conf" 2>/dev/null)"
      cx_bottle_lock "$B" || { point_rm "$IN"; stop_check; die "CrossOver is busy with $NAME. Try again in a minute. The bottle was not changed."; }
      # nothing starts from here on, and a Revit that started during the copy is not killed: the check comes before the -k
      ( bottle_guard allow_broken "$YEAR" "$NAME" ) || { cx_bottle_unlock; point_rm "$IN"; exit 1; }
      WINEPREFIX="$B" "$CX/bin/wineserver" -k 2>/dev/null </dev/null 7>&- 9>&-
      if ! wait_stopped "$B" 30; then
        cx_bottle_unlock; point_rm "$IN"; die "Programs still run in $NAME. Quit them with ./revit stop $YEAR$SFX, then try again. The bottle was not changed."
      fi
    fi
    if [ "$STOP_REQUESTED" != 0 ]; then cx_bottle_unlock; point_rm "$IN"; stop_check; fi
    point_swap "$B" "$IN" "$OLD"; rc=$?
    cx_bottle_unlock
    [ $rc != 2 ] || die "Could not bring the restore point in, and some of the bottle stayed in $(tilde "$OLD"). Run ./revit rollback $YEAR$SFX again, or copy what you need from there first."
    if [ $rc != 0 ]; then
      point_rm "$IN"; point_rm "$OLD"; die "Could not bring the restore point in. The bottle was not changed."
    fi
    point_rm "$IN"; point_rm "$OLD" || echo "Could not delete the old files: the next ./revit rollback $YEAR$SFX or ./revit points $YEAR$SFX --clear old does."
    if [ -n "$bid_old" ] && [ "$bid_old" != "$(sed -n 's/^"BottleID" = //p' "$B/cxbottle.conf" 2>/dev/null)" ]; then
      menu_apps_remove "$NAME"   # they point at the bottle that was replaced
    fi
    echo "Revit $YEAR ($NAME) is back. Start it from ~/Applications. The restore point stays: ./revit points $YEAR$SFX" ;;
  points)
    ids="$(points_ids "$NAME" "$YEAR")"
    if [ -z "$POINT_CLEAR" ]; then
      if [ "$JSON" = 1 ]; then
        out=""
        while IFS= read -r id; do
          [ -n "$id" ] || continue
          d="$(points_dir "$NAME")/$id"; by="$(point_get "$d" bytes)"; [[ "$by" =~ ^[0-9]+$ ]] || by=0
          out+="${out:+,}{\"id\":$(json_str "$id"),\"time\":$(json_str "$(point_get "$d" time)"),\"bytes\":$by}"
        done <<<"$ids"
        printf '{"bottle":%s,"year":%s,"points":[%s]}\n' "$(json_str "$NAME")" "$((10#$YEAR))" "$out"; exit 0
      fi
      [ -n "$ids" ] || { echo "No restore points of $NAME for Revit $YEAR."; exit 0; }
      while IFS= read -r id; do
        d="$(points_dir "$NAME")/$id"
        printf '  %s  %s  up to %s GB\n' "$id" "$(point_get "$d" time)" "$(points_gb "$(point_get "$d" bytes)")"
      done <<<"$ids"
      echo "To bring one back: ./revit rollback $YEAR$SFX [--to <id>]. To delete them: ./revit points $YEAR$SFX --clear old|all"
      exit 0
    fi
    targets="$ids"; [ "$POINT_CLEAR" = all ] || targets="$(tail -n +2 <<<"$ids")"
    left="$(points_leftovers "$NAME")"
    if [ -z "$targets" ] && [ -z "$left" ]; then echo "Nothing to delete."; exit 0; fi
    not_busy
    echo "This deletes:"
    while IFS= read -r id; do
      [ -n "$id" ] || continue
      printf '  restore point %s, up to %s GB\n' "$id" "$(points_gb "$(point_get "$(points_dir "$NAME")/$id" bytes)")"
    done <<<"$targets"
    [ -z "$left" ] || echo "  files of a run that was cut short"
    [ "$DRY" = 0 ] || dry_end
    confirm
    lock_take "./revit points $YEAR $NAME"
    now="$(points_ids "$NAME" "$YEAR")"   # again: only what was shown, if it is still there
    while IFS= read -r id; do
      [ -n "$id" ] && grep -qx "$id" <<<"$now" || continue
      point_drop "$NAME" "$id" || die "Could not delete restore point $id. Delete it in Finder: $(tilde "$(points_dir "$NAME")")"
    done <<<"$targets"
    points_clean "$NAME" || die "Could not delete all files in $(tilde "$(points_dir "$NAME")"). Delete them in Finder."
    points_tidy "$NAME"; echo "Deleted." ;;
  test)   # Revit plays journals in a temporary copy of the bottle (scripts/smoke.sh); documented in CONTRIBUTING
    need_crossover; bottle_guard must_exist "$YEAR" "$NAME"; not_busy
    run_ctx_new; sup_traps; lock_take --no-trap "./revit test $YEAR $NAME"; bottle_guard must_exist "$YEAR" "$NAME"
    targs=(); [ "$LOG" = 0 ] || targs+=(--log); [ "$KEEP" = 0 ] || targs+=(--keep)
    supervise "$ROOT/scripts/smoke.sh" "$YEAR" "$NAME" ${targs[@]+"${targs[@]}"} ;;
  link-installer)
    [ -n "$FOLDER" ] && [ -d "$FOLDER" ] || die "Which folder? Example: ./revit link-installer $YEAR ~/Downloads/Revit$YEAR"
    not_busy; lock_take "./revit link-installer $YEAR"
    L="$DATA/installers/revit$YEAR"; mkdir -p "$DATA/installers" || die "Cannot write to $(tilde "$DATA/installers")."
    if [ -L "$L" ]; then rm -f "$L"
    elif [ -d "$L" ]; then rmdir "$L" 2>/dev/null || die "installers/revit$YEAR already holds files. Move them away first."; fi
    ln -s "$(cd "$FOLDER" && pwd)" "$L" || die "Could not link $FOLDER"
    echo "Revit $YEAR installer: $(tilde "$(cd "$FOLDER" && pwd)")" ;;
  remove)
    APPS=(); NA=0
    for a in "Revit $YEAR" "Revit Viewer $YEAR" "Autodesk Sign-In"; do
      [ -d "$HOME/Applications/$a ($NAME).app" ] && { APPS+=("$HOME/Applications/$a ($NAME).app"); NA=$((NA + 1)); }
    done
    CXAPPS=(); while IFS= read -r a; do CXAPPS+=("$a"); done < <(cx_menu_apps "$NAME")
    if [ -d "$B" ]; then need_crossover; fi
    bottle_guard allow_missing "$YEAR" "$NAME"; not_busy
    extracted_plan
    HAD_B=0; [ -d "$B" ] && HAD_B=1
    PTS=(); while IFS= read -r id; do [ -z "$id" ] || PTS+=("$id"); done <<<"$(points_ids "$NAME" "$YEAR")"
    PLEFT="$(points_leftovers "$NAME")"
    NOTHING=0; [ "$HAD_B" = 0 ] && [ "$NA" -eq 0 ] && [ ${#CXAPPS[@]} -eq 0 ] && [ "$DROP_X" = 0 ] && [ ${#PTS[@]} -eq 0 ] && [ -z "$PLEFT" ] && NOTHING=1
    if [ "$DRY$JSON" = 11 ]; then   # the same plan as the lines below, as one JSON object
      del=""; kept=""; nj="[]"
      if [ "$NOTHING" = 0 ]; then
        [ "$HAD_B" = 1 ] && del+="${del:+,}$(item_json "bottle $NAME" "$(bytes_of "$B")")"
        [ "$DROP_X" = 1 ] && del+="${del:+,}$(item_json "installers/extracted/revit$YEAR (unpacked files)" "$(bytes_of "$X")")"
        for a in ${APPS[@]+"${APPS[@]}"}; do del+="${del:+,}$(item_json "$(tilde "$a")" null)"; done
        [ ${#CXAPPS[@]} -eq 0 ] || del+="${del:+,}$(item_json "${#CXAPPS[@]} CrossOver menu apps of $NAME in ~/Applications/CrossOver" null)"
        for id in ${PTS[@]+"${PTS[@]}"}; do
          by="$(point_get "$(points_dir "$NAME")/$id" bytes)"; del+="${del:+,}$(item_json "restore point $id" "${by:-null}")"
        done
        [ -z "$PLEFT" ] || del+="${del:+,}$(item_json "files of a restore point run that was cut short" null)"
        kept="$(json_str "installers/revit$YEAR (your downloads)")"
        [ -n "$KEEP_X" ] && kept+=",$(json_str "installers/extracted/revit$YEAR ($KEEP_X)")"
        [ "$HAD_B" = 0 ] || nj="$(notes_json)"
      fi
      printf '{"command":"remove","year":%s,"bottle":%s,"nothing":%s,"delete":[%s],"kept":[%s],"notes":%s}\n' "$((10#$YEAR))" \
        "$(json_str "$NAME")" "$([ "$NOTHING" = 1 ] && echo true || echo false)" "$del" "$kept" "$nj"
      exit 0
    fi
    if [ "$NOTHING" = 1 ]; then echo "Nothing to remove for Revit $YEAR ($NAME)."; exit 0; fi
    echo "This deletes:"
    [ "$HAD_B" = 1 ] && printf '  %-48s %s\n' "bottle $NAME" "$(size "$B")"
    [ "$DROP_X" = 1 ] && printf '  %-48s %s\n' "installers/extracted/revit$YEAR (unpacked files)" "$(size "$X")"
    for a in ${APPS[@]+"${APPS[@]}"}; do echo "  $(tilde "$a")"; done
    [ ${#CXAPPS[@]} -eq 0 ] || echo "  ${#CXAPPS[@]} CrossOver menu apps of $NAME in ~/Applications/CrossOver"
    for id in ${PTS[@]+"${PTS[@]}"}; do
      printf '  %-48s up to %s GB\n' "restore point $id" "$(points_gb "$(point_get "$(points_dir "$NAME")/$id" bytes)")"
    done
    [ -z "$PLEFT" ] || echo "  files of a restore point run that was cut short"
    [ "$HAD_B" = 1 ] && docs_note
    echo "Kept: installers/revit$YEAR (your downloads)."
    [ -n "$KEEP_X" ] && echo "Kept: installers/extracted/revit$YEAR ($KEEP_X)."
    [ "$DRY" = 0 ] || dry_end
    confirm
    lock_take "./revit remove $YEAR $NAME"
    # again, right before deleting: the bottle may have changed, or Revit started, while the user was reading
    bottle_guard allow_missing "$YEAR" "$NAME"
    # the second look may only shrink what was confirmed, never add to it
    [ "$HAD_B" = 1 ] || [ ! -e "$B" ] \
      || die "Bottle $NAME appeared while you were reading. Nothing was removed. Run ./revit remove $YEAR$SFX again."
    want_x="$DROP_X"; extracted_plan
    if [ "$want_x" = 1 ] && [ "$DROP_X" = 0 ]; then echo "Kept: installers/extracted/revit$YEAR ($KEEP_X)."; fi
    [ "$want_x" = 1 ] || DROP_X=0
    if [ -d "$B" ]; then
      # the bottle's services (Autodesk licensing) run for hours without Revit, and CrossOver does not delete a bottle
      # with programs in it: end them first (it fails when nothing runs, which is fine)
      WINEPREFIX="$B" "$CX/bin/wineserver" -k 2>/dev/null </dev/null 7>&- 9>&-
      "$CX/bin/cxbottle" --bottle "$NAME" --delete --force </dev/null 7>&- 9>&-
      [ -d "$B" ] && die "The bottle is still there: $(tilde "$B"). Nothing else was removed. Quit CrossOver and run ./revit remove $YEAR$SFX again."
    fi
    for a in ${APPS[@]+"${APPS[@]}"} ${CXAPPS[@]+"${CXAPPS[@]}"}; do
      rm -rf "$a" 2>/dev/null; [ ! -e "$a" ] || die "Could not delete $(tilde "$a"). Delete it in Finder, or run ./revit remove $YEAR$SFX again."
    done
    [ ${#CXAPPS[@]} -eq 0 ] || find "$HOME/Applications/CrossOver" -mindepth 1 -type d -empty -delete 2>/dev/null
    if [ "$DROP_X" = 1 ]; then
      rm -rf "$X" 2>/dev/null; [ ! -e "$X" ] || die "Could not delete installers/extracted/revit$YEAR. Delete it in Finder."
    fi
    now="$(points_ids "$NAME" "$YEAR")"   # only what was shown, if it is still there
    for id in ${PTS[@]+"${PTS[@]}"}; do
      grep -qx "$id" <<<"$now" || continue
      point_drop "$NAME" "$id" || die "Could not delete restore point $id. Delete it in Finder: $(tilde "$(points_dir "$NAME")")"
    done
    points_clean "$NAME" || die "Could not delete all files in $(tilde "$(points_dir "$NAME")"). Delete them in Finder."
    points_tidy "$NAME"
    echo "Removed Revit $YEAR ($NAME)." ;;
esac
